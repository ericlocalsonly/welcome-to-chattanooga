# ---- Public (safe to expose in the browser) ----
# Canonical site URL, used for SEO metadata, sitemap and share links
NEXT_PUBLIC_SITE_URL=https://welcometochattanooga.com
# Supabase project URL + publishable key (public by design; Row Level Security protects data).
# NEXT_PUBLIC_SUPABASE_ANON_KEY is also accepted for the legacy anon key.
NEXT_PUBLIC_SUPABASE_URL=https://mbbzmpwvcuuehywuarme.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_aV6DC1DZ8ZwRtk17pdj1Ag_trdSOcIY
# Optional privacy-friendly analytics (Plausible). Leave blank to disable analytics entirely.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# ---- Server-only (never prefix with NEXT_PUBLIC_) ----
# Used only by server code for admin writes and the seed script
SUPABASE_SERVICE_ROLE_KEY=
# Contact sent in the User-Agent to the National Weather Service API (required by their terms)
NWS_CONTACT_EMAIL=eric@localsonlycha.com
# Where "Suggest an update" / event submission fallbacks are sent when Supabase is not configured
CONTACT_EMAIL=eric@localsonlycha.com
